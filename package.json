{
	"name": "mana-game",
	"version": "1.0.0",
	"private": true,
	"description": "Mana Battle: monorepo root for the Phaser client, core game logic, and game server.",
	"scripts": {
		"format": "prettier --write \"phaser/src/**/*.{ts,tsx,json,css}\" \"core/src/**/*.{ts,tsx,json}\" \"server/src/**/*.{ts,tsx,json}\"",
		"format:check": "prettier --check \"phaser/src/**/*.{ts,tsx,json,css}\" \"core/src/**/*.{ts,tsx,json}\" \"server/src/**/*.{ts,tsx,json}\""
	},
	"devDependencies": {
		"prettier": "^3.6.2"
	}
}