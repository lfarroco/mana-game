# Dependencies
node_modules/

# Git
.git/

# Secrets — the root .env holds MANA_STEAM_WEB_API_KEY; it must never ride
# along in the build context (the Dockerfile reads config from the runtime env).
.env

# Client app (not needed for server)
phaser/
electron/
android/
steam/
art/

# Docs & configs (not needed at runtime)
docs/
.github/
*.md
!server/README.md
Makefile

# Test artifacts
test-results/
**/.cache/

# Server build outputs & local data (not needed in the image)
server/data/
server/dist/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
