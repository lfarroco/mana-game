{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": [
			"ES2022"
		],
		"strict": true,
		"noImplicitAny": false,
		"isolatedModules": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"noEmit": true,
		"baseUrl": ".",
		"types": [
			"node",
			"jest"
		]
	},
	"include": [
		"src/**/*.ts",
		"types/**/*.d.ts"
	],
	"exclude": [
		"dist",
		"node_modules"
	]
}