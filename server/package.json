{
  "name": "mana-game-server",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative game server for Mana Battle multiplayer sessions.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' npx jest --passWithNoTests",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' npx jest --passWithNoTests --watch"
  },
  "dependencies": {
    "express": "^5.1.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.11",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
