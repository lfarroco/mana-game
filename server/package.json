{
	"name": "mana-game-server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"dev": "tsx src/index.ts",
		"server:agents": "tsx src/index.ts",
		"test": "jest --config jest.config.cjs",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"build": "tsup src/index.ts --tsconfig tsconfig.build.json --format esm --platform node --target node22 --out-dir dist --clean",
		"start": "node dist/index.js"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"express": "^5.2.1"
	},
	"devDependencies": {
		"@types/express": "^5.0.3",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.34",
		"jest": "^29.7.0",
		"jest-util": "^29.7.0",
		"ts-jest": "^29.4.2",
		"tsup": "^8.5.0",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3"
	}
}