{
    "name": "mana_battle",
    "version": "1.1.0",
    "main": "electron/main.cjs",
    "type": "module",
    "scripts": {
        "dev": "webpack-dev-server --config webpack/config.dev.cjs",
        "server": "tsx server/index.ts",
        "dev:demo": "IS_DEMO=true webpack-dev-server --config webpack/config.dev.cjs",
        "build": "webpack --config webpack/config.prod.cjs",
        "build:debug": "webpack --config webpack/config.debug.cjs",
        "dev-nolog": "webpack-dev-server --config webpack/config.dev.cjs",
        "build-nolog": "webpack --config webpack/config.prod.cjs",
        "electron": "electron electron/main.cjs",
        "electron:dev": "NODE_ENV=development npm run build && NODE_ENV=development electron electron/main.cjs",
        "electron:dev:demo": "IS_DEMO=true NODE_ENV=development npm run build && IS_DEMO=true NODE_ENV=development electron electron/main.cjs",
        "electron:pack": "npm run build && electron-builder",
        "electron:build": "npm run build && electron-builder --publish=never",
        "electron:build:win": "npm run build && electron-builder --win --dir",
        "electron:build:mac": "npm run build && electron-builder --mac --dir",
        "electron:build:linux": "npm run build && electron-builder --linux --dir",
        "electron:build:all": "npm run build && electron-builder --win --mac --linux --dir",
        "electron:build:demo": "IS_DEMO=true npm run build && IS_DEMO=true electron-builder --publish=never --dir",
        "electron:build:demo:win": "IS_DEMO=true npm run build && IS_DEMO=true electron-builder --win --dir",
        "electron:build:demo:mac": "IS_DEMO=true npm run build && IS_DEMO=true electron-builder --mac --dir",
        "electron:build:demo:linux": "IS_DEMO=true npm run build && IS_DEMO=true electron-builder --linux --dir",
        "test": "jest",
        "test:ci": "jest --ci --maxWorkers=50%",
        "test:unit": "jest --testPathIgnorePatterns=e2e",
        "test:coverage": "jest --coverage",
        "test:mutation": "stryker run",
        "test:supabase": "deno test --no-check --allow-env supabase/functions/**/*.test.js supabase/functions/*.test.js",
        "test:e2e": "playwright test",
        "test:e2e:game-flow": "playwright test e2e/game_flow.spec.ts",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "test:bundle-size": "size-limit",
        "cap": "capacitor",
        "android:build": "npm run build && cap sync android",
        "android:open": "cap open android",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
        "check-balance": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"commonjs\"}' npx ts-node -r tsconfig-paths/register src/Utils/run_balance.ts",
        "publish:steam": "./scripts/publish_steam.sh",
        "publish:steam:demo": "./scripts/publish_steam_demo.sh",
        "bundle:edge": "tsx scripts/bundle-edge.ts",
        "deploy:functions": "npm run bundle:edge && supabase functions deploy action --project-ref supabase-project-ref-REDACTED && supabase functions deploy auth-steam --project-ref supabase-project-ref-REDACTED && supabase functions deploy replay-commit --project-ref supabase-project-ref-REDACTED && supabase functions deploy get-enemy-team --project-ref supabase-project-ref-REDACTED"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lfarroco/mana-game.git"
    },
    "author": "Mana Battle Team <redacted@example.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/lfarroco/mana-game/issues"
    },
    "homepage": "https://github.com/lfarroco/mana-game",
    "engines": {
        "node": ">=20.0.0"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@babel/core": "^7.24.5",
        "@babel/preset-env": "^7.24.5",
        "@babel/preset-typescript": "^7.27.1",
        "@capacitor/android": "^8.0.1",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/cli": "^8.0.1",
        "@capacitor/core": "^8.0.1",
        "@playwright/test": "^1.53.0",
        "@size-limit/file": "^11.2.0",
        "@stryker-mutator/core": "^9.6.0",
        "@stryker-mutator/jest-runner": "^9.6.0",
        "@types/delaunator": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "babel-loader": "^9.1.3",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "electron": "^36.2.1",
        "electron-builder": "^26.0.12",
        "esbuild": "^0.27.2",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "fast-check": "^4.6.0",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^5.6.0",
        "identity-obj-proxy": "^3.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^16.3.3",
        "phaser3_gui_inspector": "^1.2.1",
        "prettier": "^3.6.2",
        "raw-loader": "^4.0.2",
        "size-limit": "^11.2.0",
        "terser-webpack-plugin": "^5.3.10",
        "ts-jest": "^29.4.0",
        "ts-loader": "^9.5.1",
        "tsconfig-paths-webpack-plugin": "^4.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.4.5",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.4",
        "webpack-merge": "^5.10.0"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.89.0",
        "@types/express": "^4.17.25",
        "@types/pg": "^8.16.0",
        "delaunator": "^5.0.1",
        "dotenv": "^17.2.3",
        "easystarjs": "^0.4.4",
        "express": "^5.2.1",
        "pg": "^8.16.3",
        "phaser": "^3.88.2",
        "phaser3-rex-plugins": "^1.80.16",
        "plist": "^3.1.0",
        "steamworks.js": "^0.4.0",
        "uuid": "^11.1.0"
    },
    "size-limit": [
        {
            "name": "web-bundle",
            "path": "dist/bundle.min.js",
            "limit": "1200 kB"
        }
    ],
    "build": {
        "appId": "com.manabattle",
        "productName": "Mana Battle",
        "directories": {
            "output": "dist-electron",
            "buildResources": "electron/build"
        },
        "files": [
            "dist/**/*",
            "electron/main.cjs",
            "electron/preload.cjs",
            "package.json",
            "electron/assets",
            "!node_modules/**/*",
            "node_modules/steamworks.js/**/*"
        ],
        "asarUnpack": [
            "node_modules/steamworks.js/**/*"
        ],
        "compression": "maximum",
        "mac": {
            "category": "public.app-category.games",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "universal"
                    ]
                }
            ]
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}