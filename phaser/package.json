{
    "name": "mana_battle",
    "version": "1.2.1",
    "main": "electron/main.js",
    "scripts": {
        "dev": "node log.js dev && webpack-dev-server --config webpack/config.dev.js --open",
        "build": "node log.js build && webpack --config webpack/config.prod.js",
        "dev-nolog": "webpack-dev-server --config webpack/config.dev.js --open",
        "build-nolog": "webpack --config webpack/config.prod.js",
        "electron": "electron electron/main.js",
        "electron:dev": "npm run build && electron electron/main.js",
        "electron:pack": "npm run build && electron-builder",
        "electron:build": "npm run build && electron-builder --publish=never",
        "electron:build:win": "npm run build && electron-builder --win",
        "electron:build:mac": "npm run build && electron-builder --mac",
        "electron:build:linux": "npm run build && electron-builder --linux",
        "electron:build:all": "npm run build && electron-builder --win --mac --linux",
        "test": "jest",
        "test:unit": "jest --testPathIgnorePatterns=e2e",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:debug": "playwright test --debug",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lfarroco/mana-game.git"
    },
    "author": "Mana Battle Team <redacted@example.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/lfarroco/mana-game/issues"
    },
    "homepage": "https://github.com/lfarroco/mana-game",
    "devDependencies": {
        "@babel/core": "^7.24.5",
        "@babel/preset-env": "^7.24.5",
        "@babel/preset-typescript": "^7.27.1",
        "@playwright/test": "^1.53.0",
        "@types/delaunator": "^5.0.3",
        "@types/jest": "^29.5.14",
        "@typescript-eslint/eslint-plugin": "^8.47.0",
        "@typescript-eslint/parser": "^8.47.0",
        "babel-loader": "^9.1.3",
        "clean-webpack-plugin": "^4.0.0",
        "copy-webpack-plugin": "^12.0.2",
        "electron": "^36.2.1",
        "electron-builder": "^26.0.12",
        "eslint": "^9.39.1",
        "eslint-config-prettier": "^10.1.8",
        "file-loader": "^6.2.0",
        "html-webpack-plugin": "^5.6.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "phaser3_gui_inspector": "^1.2.1",
        "prettier": "^3.6.2",
        "raw-loader": "^4.0.2",
        "terser-webpack-plugin": "^5.3.10",
        "ts-jest": "^29.4.0",
        "ts-loader": "^9.5.1",
        "tsconfig-paths-webpack-plugin": "^4.0.0",
        "typescript": "^5.4.5",
        "webpack": "^5.91.0",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.4",
        "webpack-merge": "^5.10.0"
    },
    "dependencies": {
        "delaunator": "^5.0.1",
        "easystarjs": "^0.4.4",
        "phaser": "^3.88.2",
        "phaser3-rex-plugins": "^1.80.16",
        "plist": "^3.1.0",
        "steamworks.js": "^0.4.0",
        "uuid": "^11.1.0"
    },
    "build": {
        "appId": "com.manabattle",
        "productName": "Mana Battle",
        "directories": {
            "output": "dist-electron",
            "buildResources": "electron/build"
        },
        "files": [
            "dist/**/*",
            "electron/main.js",
            "electron/preload.js",
            "package.json",
            "electron/assets",
            "!node_modules/**/*",
            "node_modules/steamworks.js/**/*"
        ],
        "asarUnpack": [
            "node_modules/steamworks.js/**/*"
        ],
        "compression": "maximum",
        "mac": {
            "category": "public.app-category.games",
            "target": [
                {
                    "target": "dmg",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "ia32"
                    ]
                }
            ]
        },
        "linux": {
            "target": [
                {
                    "target": "AppImage",
                    "arch": [
                        "x64"
                    ]
                },
                {
                    "target": "deb",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    }
}