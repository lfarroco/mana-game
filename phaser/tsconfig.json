{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "outDir": "./dist/",
        "baseUrl": "./src",
        "paths": {
            "@Models/*": [
                "Models/*"
            ],
            "@Scenes/*": [
                "Scenes/*"
            ],
            "@Systems/*": [
                "Systems/*"
            ],
            "@UI/*": [
                "UI/*"
            ],
            "@Utils/*": [
                "Utils/*"
            ],
            "@Constants/*": [
                "Constants/*"
            ],
            "@PhaserIO": [
                "phaser.io.ts"
            ],
            "@Components/*": [
                "Components/*"
            ],
            "@Shaders/*": [
                "Shaders/*"
            ]
        },
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Linting */
        "strict": true,
        "strictPropertyInitialization": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ],
}