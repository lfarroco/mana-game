{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "outDir": "./dist/",
        "rootDir": "../",
        "paths": {
            "@game/*": [
                "../core/src/*"
            ],
            "@Models/*": [
                "./src/Models/*"
            ],
            "@Screens/*": [
                "./src/Client/Screens/*"
            ],
            "@Systems/*": [
                "./src/Systems/*"
            ],
            "@Utils/*": [
                "./src/Utils/*"
            ],
            "@Constants": [
                "./src/Constants"
            ],
            "@IO": [
                "./src/io.ts"
            ],
            "@Components/*": [
                "./src/Client/Components/*"
            ],
            "@Shaders/*": [
                "./src/Shaders/*"
            ],
            "@i18n/*": [
                "./src/i18n/*"
            ],
            "@lib/*": [
                "./src/lib/*"
            ],
            "@Core/*": [
                "./src/Core/*"
            ],
            "@Multiplayer/*": [
                "./src/Multiplayer/*"
            ],
            "@Data/*": [
                "./src/Data/*"
            ],
            "@Game/*": [
                "./src/Game/*"
            ],
            "@TriggerSystem/*": [
                "../core/src/TriggerSystem/*"
            ],
            "Client/*": [
                "./src/Client/*"
            ],
            "TriggerSystem/*": [
                "../core/src/TriggerSystem/*"
            ],
            "@config": [
                "./src/config.ts"
            ],
            "@main": [
                "./src/main.ts"
            ],
            "@Storage/*": [
                "./src/Storage/*"
            ],
            "@FX": [
                "./src/Client/FX.ts"
            ],
            "@Engine/*": [
                "./src/Engine/*"
            ],
            "@assets": [
                "./src/assets.ts"
            ],
            "@utils": [
                "./src/utils.ts"
            ],
            "@test-utils/*": [
                "./src/test-utils/*"
            ]
        },
        "types": [
            "jest"
        ],
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Linting */
        "strict": true,
        "strictPropertyInitialization": true,
        "strictNullChecks": true,
        "strictFunctionTypes": true,
        "strictBindCallApply": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitAny": true,
        "noImplicitThis": true
    },
    "include": [
        "src",
        "server",
        "../core/src/Models.ts",
        "../core/src/Combat/CombatLogger.ts",
        "../core/src/CombatTypes.ts",
        "../core/src/Combat/CombatStatsTracker.ts",
        "../core/src/TriggerSystem",
        "../core/src/Entities",
        "../core/src/Combat/PoisonDamageSystem.ts",
        "../core/src/Combat/RegenSystem.ts",
        "../core/src/Combat/TimeoutDamageSystem.ts",
        "../core/src/Constants.ts",
        "../core/src/Combat/StatusEffectSystem.ts",
        "../core/src/Combat/CombatRunner.ts",
        "../core/src/CombatConstants.ts",
        "../core/src/Combat/CombatSimulation.test.ts",
        "../core/src/Combat/CombatSimulation.ts",
        "../core/src/BaseCollection.ts",
        "../core/src/Geometry.ts",
        "../core/src/BoardLogic.ts"
    ],
    "exclude": [
        "node_modules"
    ],
}