{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "outDir": "./dist/",
        "baseUrl": "./src",
        "paths": {
            "@Models/*": [
                "Models/*"
            ],
            "@Scenes/*": [
                "Engine/Scenes/*"
            ],
            "@Systems/*": [
                "Systems/*"
            ],
            "@UI/*": [
                "UI/*"
            ],
            "@Utils/*": [
                "Utils/*"
            ],
            "@Constants/*": [
                "Constants/*"
            ],
            "@PhaserIO": [
                "phaser.io.ts"
            ],
            "@Components/*": [
                "Components/*"
            ],
            "@Shaders/*": [
                "Shaders/*"
            ],
            "@i18n/*": [
                "i18n/*"
            ],
            "@lib/*": [
                "lib/*"
            ],
            "@Core/*": [
                "Core/*"
            ],
            "@Multiplayer/*": [
                "Multiplayer/*"
            ],
            "@Data/*": [
                "Data/*"
            ],
            "@Game/*": [
                "Game/*"
            ],
            "@TriggerSystem/*": [
                "TriggerSystem/*"
            ],
            "@config": [
                "config.ts"
            ],
            "@assets": [
                "assets.ts"
            ],
            "@utils": [
                "utils.ts"
            ]
        },
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Linting */
        "strict": true,
        "strictPropertyInitialization": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src",
        "server"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ],
}