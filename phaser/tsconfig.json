{
    "compilerOptions": {
        "target": "ES2020",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "outDir": "./dist/",
        "rootDir": "./src/",
        "paths": {
            "@Models/*": [
                "./src/Models/*"
            ],
            "@Screens/*": [
                "./src/Client/Screens/*"
            ],
            "@Systems/*": [
                "./src/Systems/*"
            ],
            "@Utils/*": [
                "./src/Utils/*"
            ],
            "@Constants/*": [
                "./src/Constants/*"
            ],
            "@PhaserIO": [
                "./src/phaser.io.ts"
            ],
            "@Components/*": [
                "./src/Components/*"
            ],
            "@Shaders/*": [
                "./src/Shaders/*"
            ],
            "@i18n/*": [
                "./src/i18n/*"
            ],
            "@lib/*": [
                "./src/lib/*"
            ],
            "@Core/*": [
                "./src/Core/*"
            ],
            "@Multiplayer/*": [
                "./src/Multiplayer/*"
            ],
            "@Data/*": [
                "./src/Data/*"
            ],
            "@Game/*": [
                "./src/Game/*"
            ],
            "@TriggerSystem/*": [
                "./src/TriggerSystem/*"
            ],
            "Client/*": [
                "./src/Client/*"
            ],
            "TriggerSystem/*": [
                "./src/TriggerSystem/*"
            ],
            "@config": [
                "./src/config.ts"
            ],
            "@main": [
                "./src/main.ts"
            ],
            "@Storage/*": [
                "./src/Storage/*"
            ],
            "@Effects/*": [
                "./src/Effects/*"
            ],
            "@Engine/*": [
                "./src/Engine/*"
            ],
            "@assets": [
                "./src/assets.ts"
            ],
            "@utils": [
                "./src/utils.ts"
            ],
            "@test-utils/*": [
                "./src/test-utils/*"
            ]
        },
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        /* Linting */
        "strict": true,
        "strictPropertyInitialization": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": [
        "src",
        "server"
    ],
    "exclude": [
        "node_modules",
        "**/*.spec.ts"
    ],
}