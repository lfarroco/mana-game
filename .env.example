# Copy to .env and fill in the secrets. This committed example is the source
# for BOTH deployments (docker compose and the bare systemd setup) — keep it
# in bare KEY=value form: NO quotes, NO `export` (systemd's EnvironmentFile
# parser treats quotes literally).
#
#   cp .env.example .env
#   $EDITOR .env
#
# The real .env is gitignored.

# Required — enables POST /api/v1/auth/steam (server secret, never client-side).
# Use the key from https://steamcommunity.com/dev/apikey (standard Web API key)
# together with the MANA_STEAM_API_URL line below — or a publisher Web API key
# (Steamworks partner site) if you prefer the partner endpoint.
MANA_STEAM_WEB_API_KEY=your-steam-web-api-key

# Comma-separated Steam app-id allowlist (alpha + demo).
MANA_STEAM_APP_IDS=3757600,4233280

# AuthenticateUserTicket endpoint. The server default is the partner node
# (https://partner.steam-api.com/...), which REQUIRES a publisher Web API key.
# With a standard key from steamcommunity.com/dev/apikey you must use the public
# endpoint instead (rate-limited). This line is safe for both key types.
MANA_STEAM_API_URL=https://api.steampowered.com/ISteamUserAuth/AuthenticateUserTicket/v1/

# Set to true to register POST /api/v1/auth/itch (itch.io web build login).
MANA_ITCH_ENABLED=true

# Allowed browser origin(s): "*" or a comma-separated list. For the web build
# use the itch.io game-page origin, e.g. https://lfarroco.itch.io. Bearer-token
# auth (no cookies) means "*" is safe here — see server/README.md §CORS.
MANA_CORS_ORIGIN=*

# Optional: host port (compose host mapping / bare listen port), default 8787.
# MANA_SERVER_PORT=8787

# Optional: TLS domain for the compose `caddy` service and the bare setup's
# Caddy (renders into server/Caddyfile.docker / /etc/caddy/Caddyfile).
# MANA_API_DOMAIN=api.manabattle.com

# --- Client release-build vars (consumed by `npm run build` and the
# `make electron-build-*` targets — the Makefile sources this file, so setting
# them here bakes them into web AND Electron release builds). The server
# ignores these; they live here so one .env drives both the deployment and the
# release builds. See docs/building-and-running.md §Multiplayer auth
# configuration and docs/release-audit.md.
#
# Game-server base URL for released clients. LEAVE UNSET for local dev (the
# client falls back to http://127.0.0.1:8787). Set for the live game —
# otherwise shipped builds point multiplayer at the player's own machine:
# MANA_SERVER_URL=https://api.manabattle.com
#
# itch.io OAuth client id for the web build (public — ships in the browser
# bundle; the same value is registered for the game's OAuth app in
# docs/itchio-auth.md). Empty disables browser multiplayer login:
# MANA_ITCH_CLIENT_ID=f20213f3887151a962afac88d0145c57
