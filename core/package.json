{
	"name": "@mana/core",
	"version": "0.1.0",
	"private": true,
	"description": "Pure, framework-agnostic game logic shared by the Phaser client, the Node agent server, and Supabase edge functions.",
	"type": "module",
	"exports": {
		"./*": "./src/*.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "NODE_OPTIONS='--experimental-vm-modules' npx jest --passWithNoTests",
		"test:watch": "NODE_OPTIONS='--experimental-vm-modules' npx jest --passWithNoTests --watch"
	},
	"dependencies": {
		"uuid": "^14.0.1"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"jest": "^29.7.0",
		"ts-jest": "^29.4.11",
		"tsx": "^4.23.1"
	}
}
